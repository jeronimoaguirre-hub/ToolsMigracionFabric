{
  "mcpServers": {
    "microsoft-fabric": {
      "type": "stdio",
      "command": "dnx",
      "args": [
        "Microsoft.Fabric.Mcp@1.3.0",
        "--yes",
        "--",
        "server",
        "start"
      ],
      "env": {
        "AZURE_TOKEN_CREDENTIALS": "AzureCliCredential"
      }
    }
  }
}
