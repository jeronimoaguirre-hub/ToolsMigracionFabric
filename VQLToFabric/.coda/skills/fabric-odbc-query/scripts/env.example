# Copia este archivo como ".env" en la raíz del repo (junto a pyproject.toml)
# y completa los valores. .env NO debe subirse a control de versiones.

FABRIC_DRIVER=ODBC Driver 17 for SQL Server
FABRIC_SERVER=xxxxx.datawarehouse.fabric.microsoft.com
FABRIC_DATABASE=nombre_del_warehouse_gold
# Opcional, default ActiveDirectoryInteractive (abre login en el navegador
# la primera vez; el propio driver cachea el token en las siguientes):
FABRIC_AUTH=ActiveDirectoryInteractive
