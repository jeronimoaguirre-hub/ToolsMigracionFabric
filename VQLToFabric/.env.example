# Copia este archivo como ".env" en la raíz y completa los valores.
# .env NO se versiona. Nunca lo pegues en un chat ni en un ledger.

# --- Fabric Warehouse (skill fabric-odbc-query) ---
FABRIC_DRIVER=ODBC Driver 17 for SQL Server
FABRIC_SERVER=xxxxx.datawarehouse.fabric.microsoft.com
FABRIC_DATABASE=nombre_del_warehouse_gold
# Opcional; default ActiveDirectoryInteractive (login en navegador la primera vez):
FABRIC_AUTH=ActiveDirectoryInteractive

