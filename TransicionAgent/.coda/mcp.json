{
  "mcpServers": {
    "microsoft-fabric": {
      "command": "dnx",
      "args": [
        "Microsoft.Fabric.Mcp@1.3.0",
        "--yes",
        "--",
        "server",
        "start"
      ],
      "env": {
        "AZURE_TOKEN_CREDENTIALS": "AzureCliCredential"
      }
    },
    "azure-devops": {
      "command": "npx",
      "args": [
        "-y",
        "@azure-devops/mcp",
        "ecopetrolad",
        "--authentication",
        "interactive"
      ]
    }
  }
}
